# Hetzner Cloud API token (read access minimum), used server-side only.
# Create one at: https://console.hetzner.cloud -> Project -> Security -> API Tokens
HETZNER_API_TOKEN=

# Password to access the dashboard (single user, no accounts).
DASHBOARD_PASSWORD=

# Secret used to sign the session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Path to the SQLite database file (relative to the process cwd, or absolute).
# Inside Docker this is bind-mounted to ./data on the host so it survives restarts.
DATABASE_PATH=./data/vps-dashboard.db
