# Hetzner Cloud API token (read access minimum), used server-side only.
# Create one at: https://console.hetzner.cloud -> Project -> Security -> API Tokens
HETZNER_API_TOKEN=

# Password to access the dashboard (single user, no accounts).
DASHBOARD_PASSWORD=

# Secret used to sign the session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Path to the SQLite database file (relative to the process cwd, or absolute).
# Inside Docker this is bind-mounted to ./data on the host so it survives restarts.
DATABASE_PATH=./data/vps-dashboard.db

# --- Agent tunnel (docker-compose "agent-tunnel" service) ---
# The dashboard reaches each VPS agent through a permanent SSH tunnel rather
# than the agent's port being exposed on the public internet. Uses a
# dedicated, single-purpose SSH key — never your personal key. See README
# "Agent tunnel" for how to generate the key and restrict it on the VPS.

# VPS IP or hostname the tunnel connects to.
TUNNEL_HOST=

# Absolute path, on this machine, to the dedicated tunnel private key.
TUNNEL_SSH_KEY=

# Optional overrides (defaults shown):
# TUNNEL_USER=tunnel
# TUNNEL_REMOTE_PORT=9090
# TUNNEL_LOCAL_PORT=9090
